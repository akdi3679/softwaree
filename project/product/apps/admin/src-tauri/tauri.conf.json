{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Product Admin",
  "version": "0.1.0",
  "identifier": "com.product.admin",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Product Admin",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "deb", "appimage", "dmg"],
    "icon": ["icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Business",
    "shortDescription": "Product Admin",
    "longDescription": "Product Admin desktop application."
  }
}
