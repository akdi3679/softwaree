# ============================================================
# Minimal .gitignore - only the truly huge / dangerous stuff
# ============================================================

# Huge build folders (must exclude or GitHub rejects the push)
node_modules/
**/node_modules/
target/
**/target/

# Secrets — NEVER push these
.env
.env.*
*.pem
*.key

# Nested git backups from our earlier rename
**/.git.bak/